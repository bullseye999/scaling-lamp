# =====================================================================
# CIPH DEEPSEEK V4 PRO ENVIRONMENT CONFIGURATION
# =====================================================================

# DeepSeek V4 Pro API Configuration (Optional - cloud reasoning & briefings)
# Leave commented out or empty to run in sovereign offline/heuristic mode
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Example defaults only. The provider may serve "deepseek-chat" as a DIFFERENT underlying
# model (it can resolve to an alias such as deepseek-flash). The last private demonstration
# used DEEPSEEK_MODEL=deepseek-v4-pro. Set the model you intend to use and verify the SERVED
# identity (e.g. via /model-status) rather than assuming the example selects your model.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------
# [DEPRECATED RUNPOD CONFIGURATION - KEPT FOR REFERENCE]
# ---------------------------------------------------------------------
