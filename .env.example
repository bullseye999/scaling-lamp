# =====================================================================
# CIPH ENVIRONMENT CONFIGURATION
# =====================================================================

# DeepSeek V4 Pro API Configuration (PRIMARY)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Optional API Integrations
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
ODDS_API_KEY=your_odds_api_key_here


# Optional: derive the vault key from an operator-controlled passphrase.
# If omitted, CIPH creates a random per-installation key in ignored ciph.key.
CIPH_VAULT_PASSPHRASE=choose_a_unique_private_passphrase

# Required only when creating encrypted backups.
BACKUP_PASSPHRASE=choose_a_separate_backup_passphrase
